// # oochgrp Group Database Resolution Subsystem
//
// Logline: Ingests, parses, and indexes /etc/group records for name and numeric GID resolution.
//
// Setup: Decodes standard colon-delimited group records into structured GroupEntry entities.
//
// Beats:
//   1. Parse individual /etc/group formatted entries into typed records.
//   2. Parse multi-line group database streams into indexed collections.
//   3. Resolve group entries by symbolic name or numeric identifier.
//   4. Ingest system /etc/group via explicit capability token.

import "core/chgrp_types.oo";

pub fn is_numeric(s: String) -> Bool {
    let n: Int = chars_len(s);
    if n == 0 {
        return false;
    }
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if !char_is_digit(ch) {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn parse_gid(s: String) -> Int {
    let n: Int = chars_len(s);
    let mut val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(s, i);
        if char_is_digit(ch) {
            let d: Int = if ch == "0" { 0 }
            else if ch == "1" { 1 }
            else if ch == "2" { 2 }
            else if ch == "3" { 3 }
            else if ch == "4" { 4 }
            else if ch == "5" { 5 }
            else if ch == "6" { 6 }
            else if ch == "7" { 7 }
            else if ch == "8" { 8 }
            else if ch == "9" { 9 }
            else { 0 };
            val = val * 10 + d;
            i = i + 1;
        } else {
            return val;
        }
    }
    return val;
}

pub fn parse_group_line(raw_line: String) -> GroupEntry {
    let line: String = str_trim(raw_line);
    if chars_len(line) == 0 || str_starts_with(line, "#") {
        return make_group_entry("", -1, "");
    }
    let parts: List[String] = str_split(line, ":");
    let count: Int = list_len(parts);
    if count < 3 {
        return make_group_entry("", -1, "");
    }
    let name: String = str_trim(list_get(parts, 0));
    let gid_str: String = str_trim(list_get(parts, 2));
    let gid: Int = parse_gid(gid_str);
    let members: String = if count >= 4 { str_trim(list_get(parts, 3)) } else { "" };
    return make_group_entry(name, gid, members);
}

pub fn parse_group_database(text: String) -> List[GroupEntry] {
    let mut entries: List[GroupEntry] = list_new();
    let lines: List[String] = str_split(text, "\n");
    let n: Int = list_len(lines);
    let mut i: Int = 0;
    while i < n {
        let line: String = list_get(lines, i);
        let entry: GroupEntry = parse_group_line(line);
        if entry.gid >= 0 && chars_len(entry.name) > 0 {
            entries = list_push(entries, entry);
        }
        i = i + 1;
    }
    return entries;
}

pub fn find_group_by_name(groups: List[GroupEntry], target: String) -> GroupEntry {
    let n: Int = list_len(groups);
    let mut i: Int = 0;
    while i < n {
        let entry: GroupEntry = list_get(groups, i);
        if entry.name == target {
            return entry;
        }
        i = i + 1;
    }
    return make_group_entry("", -1, "");
}

pub fn find_group_by_gid(groups: List[GroupEntry], target_gid: Int) -> GroupEntry {
    let n: Int = list_len(groups);
    let mut i: Int = 0;
    while i < n {
        let entry: GroupEntry = list_get(groups, i);
        if entry.gid == target_gid {
            return entry;
        }
        i = i + 1;
    }
    return make_group_entry("", -1, "");
}

pub fn resolve_group(groups: List[GroupEntry], spec: String) -> GroupEntry {
    if is_numeric(spec) {
        let target_gid: Int = parse_gid(spec);
        let match_gid: GroupEntry = find_group_by_gid(groups, target_gid);
        if match_gid.gid >= 0 {
            return match_gid;
        }
        return make_group_entry(spec, target_gid, "");
    }
    return find_group_by_name(groups, spec);
}

pub fn load_system_groups(fs: &FsReadCap) -> List[GroupEntry] {
    let r: Result[String, String] = read_file(fs, "/etc/group");
    if r.is_ok() {
        let content: String = match r { Ok(s) => s, Err(_) => "" };
        return parse_group_database(content);
    }
    let mut fallback: List[GroupEntry] = list_new();
    fallback = list_push(fallback, make_group_entry("root", 0, ""));
    fallback = list_push(fallback, make_group_entry("wheel", 10, ""));
    fallback = list_push(fallback, make_group_entry("users", 100, ""));
    return fallback;
}
